{
  "name": "polytrader-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "collector": "node --env-file-if-exists=.env.local scripts/collector.ts",
    "bundle:neon": "node scripts/bundle-neon.mjs",
    "telegram:configure": "node --env-file-if-exists=.env.local scripts/configure-telegram.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-db.mjs",
    "collector:start": "node scripts/collector-control.mjs start",
    "collector:stop": "node scripts/collector-control.mjs stop",
    "collector:status": "node scripts/collector-control.mjs status",
    "collector:launchd": "node scripts/collector-control.mjs launchd",
    "collector:check": "node --env-file-if-exists=.env.local scripts/collector.ts --probe=600",
    "weather": "node --env-file-if-exists=.env.local scripts/weather-collector.ts",
    "weather:network": "node --env-file-if-exists=.env.local scripts/weather-network-check.ts",
    "weather:check": "node --env-file-if-exists=.env.local scripts/weather-collector.ts --probe",
    "weather:start": "node scripts/collector-control.mjs start --weather",
    "weather:stop": "node scripts/collector-control.mjs stop --weather",
    "weather:status": "node scripts/collector-control.mjs status --weather",
    "weather:launchd": "node scripts/collector-control.mjs launchd --weather",
    "weather:verify": "node --env-file-if-exists=.env.local scripts/verify-weather-db.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@types/ws": "8.18.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.0",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@neon/functions": "^0.11.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  }
}
